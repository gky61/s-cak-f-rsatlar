<!DOCTYPE html>
<html lang="tr">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">

  <!-- Primary Meta Tags -->
  <title>FırsatKolik — Türkiye'nin En Sıcak İndirim & Fırsat Topluluğu</title>
  <meta name="title" content="FırsatKolik — Türkiye'nin En Sıcak İndirim & Fırsat Topluluğu">
  <meta name="description"
    content="Amazon, Trendyol, Hepsiburada, BİM, A101 ve 40+ süpermarketin en dip fiyat fırsatları, indirim kuponları ve haftalık aktüel broşürleri tek bir uygulamada anında cebinde!">
  <meta name="keywords"
    content="fırsatkolik, sıcak fırsatlar, indirim kuponu, aktüel ürünler, a101 aktüel, bim aktüel, şok aktüel, migros indirimleri, trendyol kupon kodu, amazon fırsatları">
  <meta name="author" content="FırsatKolik">
  <meta name="theme-color" content="#05070B">

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://firsatkolik.app/">
  <meta property="og:title" content="FırsatKolik — İndirimleri İlk Sen Yakala!">
  <meta property="og:description"
    content="Yüzlerce mağazanın anlık indirimleri, aktüel broşürleri ve indirim kuponları cebinde. Sahte indirimlere son ver!">
  <meta property="og:image" content="assets/foreground.png">

  <!-- Twitter -->
  <meta property="twitter:card" content="summary_large_image">
  <meta property="twitter:url" content="https://firsatkolik.app/">
  <meta property="twitter:title" content="FırsatKolik — İndirimleri İlk Sen Yakala!">
  <meta property="twitter:description"
    content="Yüzlerce mağazanın anlık indirimleri, aktüel broşürleri ve indirim kuponları cebinde.">
  <meta property="twitter:image" content="assets/foreground.png">

  <!-- Favicon & PWA -->
  <link rel="icon" type="image/png" href="favicon.png">
  <link rel="apple-touch-icon" href="icons/Icon-192.png">
  <link rel="manifest" href="manifest.json">

  <!-- Google Fonts: Plus Jakarta Sans & JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800;900&display=swap"
    rel="stylesheet">

  <!-- FontAwesome 6 Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

  <!-- Showcase Stylesheet -->
  <link rel="stylesheet" href="showcase.css?v=all-icons-synced">
</head>

<body>

  <!-- Ambient Light Effects -->
  <div class="ambient-glow"></div>
  <div class="ambient-glow-bottom"></div>
  <div class="grid-overlay"></div>

  <!-- ==========================================================================
       Header / Navbar (Spacious, Elegant, No Wrapping)
       ========================================================================== -->
  <header class="site-header">
    <div class="container nav-container">
      <a href="#" class="brand-logo">
        <div class="brand-icon">
          <img src="assets/foreground.png" alt="FırsatKolik Logo" onerror="this.src='favicon.png'">
        </div>
        <div class="brand-text">
          <span class="brand-title">FırsatKolik</span>
          <span class="brand-subtitle">İndirim Radarı</span>
        </div>
      </a>

      <!-- Desktop Nav -->
      <ul class="nav-links">
        <li><a href="#firsatlar"><i class="fa-solid fa-fire" style="color: #FF6B35;"></i> Fırsatlar</a></li>
        <li><a href="#alarmlar"><i class="fa-solid fa-crosshairs" style="color: #60A5FA;"></i> Fırsat Radarı</a></li>
        <li><a href="#aktuel"><i class="fa-solid fa-book-open" style="color: #34D399;"></i> Aktüel</a></li>
        <li><a href="#kuponlar"><i class="fa-solid fa-ticket" style="color: #FBBF24;"></i> Kuponlar</a></li>
        <li><a href="#topluluk"><i class="fa-solid fa-trophy" style="color: #C084FC;"></i> Avcı Kulübü</a></li>
        <li><a href="#sss"><i class="fa-solid fa-circle-question" style="color: #94A3B8;"></i> SSS</a></li>
      </ul>

      <!-- Action Button -->
      <div class="nav-actions">
        <a href="#firsatlar" class="btn btn-primary btn-sm">
          <i class="fa-solid fa-fire"></i> Fırsatları Yakala
        </a>
        <button class="menu-toggle" id="menu-toggle" aria-label="Menü">
          <i class="fa-solid fa-bars"></i>
        </button>
      </div>
    </div>
  </header>

  <!-- Mobile Drawer -->
  <div class="mobile-drawer" id="mobile-drawer">
    <a href="#firsatlar"><i class="fa-solid fa-fire" style="color: #FF6B35;"></i> Günün Trend İndirimleri</a>
    <a href="#alarmlar"><i class="fa-solid fa-crosshairs" style="color: #60A5FA;"></i> Akıllı Arama & Fırsat Radarı</a>
    <a href="#aktuel"><i class="fa-solid fa-book-open" style="color: #34D399;"></i> 40+ Market Aktüel Broşürleri</a>
    <a href="#kuponlar"><i class="fa-solid fa-ticket" style="color: #FBBF24;"></i> Mağaza İndirim Kuponları</a>
    <a href="#topluluk"><i class="fa-solid fa-trophy" style="color: #C084FC;"></i> Yapay Zeka Paylaşım & Avcı Kulübü</a>
    <a href="#sss"><i class="fa-solid fa-circle-question" style="color: #94A3B8;"></i> Sıkça Sorulan Sorular</a>
  </div>

  <!-- ==========================================================================
       First Screen Above-the-Fold (Hero + Dual Store Marquee Stream)
       ========================================================================== -->
  <div class="first-fold-wrapper">
    <!-- Hero Section (Consumer Value Proposition) -->
    <section class="hero-section" id="hero">
      <div class="container hero-grid">

        <!-- Left Content -->
        <div class="hero-content">
          <div class="badge-pill hero-pill">
            <span class="pulse-dot"></span>
            <span>TÜRKİYE'NİN EN SICAK FIRSAT TOPLULUĞU</span>
          </div>

          <h1 class="hero-title">
            İndirimleri İlk Sen Yakala,<br>
            <span class="gradient-text">Her Alışverişinde</span> <span class="gradient-text-fire">Tasarruf Et!</span>
          </h1>

          <p class="hero-description">
            30+ E-Ticaret sitesinin anlık dip fiyatları, 40+ zincir marketin haftalık aktüel katalogları ve indirim
            kuponları tek uygulamada. Toplulukla gerçek fırsatları ilk siz keşfedin!
          </p>

          <div class="hero-actions">
            <a href="#firsatlar" class="btn btn-primary btn-lg">
              <i class="fa-solid fa-fire"></i> Fırsatları Keşfet
            </a>
            <a href="#alarmlar" class="btn btn-secondary btn-lg">
              <i class="fa-solid fa-crosshairs"></i> Fiyat Alarmı Kur
            </a>
          </div>

          <!-- Killer Features Spotlight Bar (Authentic & Consumer-Focused) -->
          <div class="hero-killer-grid">
            <a href="#firsatlar" class="hero-killer-card">
              <div class="killer-card-icon hot">
                <i class="fa-solid fa-fire"></i>
              </div>
              <div class="killer-card-body">
                <span class="killer-card-title">Günün Sıcak Fırsatları</span>
                <span class="killer-card-sub">Topluluk oylarıyla seçilen en iyi indirimler</span>
              </div>
            </a>

            <a href="#alarmlar" class="hero-killer-card">
              <div class="killer-card-icon blue">
                <i class="fa-solid fa-crosshairs"></i>
              </div>
              <div class="killer-card-body">
                <span class="killer-card-title">Akıllı Fırsat Radarı</span>
                <span class="killer-card-sub">Kelime ve kategori bazlı anlık fiyat alarmları</span>
              </div>
            </a>

            <a href="#aktuel" class="hero-killer-card">
              <div class="killer-card-icon emerald">
                <i class="fa-solid fa-book-open"></i>
              </div>
              <div class="killer-card-body">
                <span class="killer-card-title">Haftalık Aktüel Kataloglar</span>
                <span class="killer-card-sub">BİM, A101, ŞOK ve 40+ marketin güncel indirim katalogları</span>
              </div>
            </a>

            <a href="#kuponlar" class="hero-killer-card">
              <div class="killer-card-icon gold">
                <i class="fa-solid fa-ticket"></i>
              </div>
              <div class="killer-card-body">
                <span class="killer-card-title">İndirim Kuponları</span>
                <span class="killer-card-sub">Hepsiburada, Trendyol, Amazon ve popüler mağazaların indirim
                  kodları</span>
              </div>
            </a>
          </div>
        </div>

        <!-- Right Visual: Authentic Interactive iPhone 17 Pro Max Mockup -->
        <div class="hero-visual" id="mockup">
          <div class="phone-mockup-wrapper">
            <div class="phone-mockup-glow"></div>

            <!-- iPhone 17 Pro Natural Titanium Hardware Buttons -->
            <div class="iphone-hw-btn action-btn"></div>
            <div class="iphone-hw-btn vol-up-btn"></div>
            <div class="iphone-hw-btn vol-down-btn"></div>
            <div class="iphone-hw-btn power-btn"></div>
            <div class="iphone-hw-btn camera-control-btn"></div>

            <!-- Phone Bezel Frame (iPhone 17 Pro Max Titanium Chassis) -->
            <div class="phone-frame iphone-17-pro">
              <!-- Ceramic Glass Diagonal Glare Reflection -->
              <div class="phone-glass-glare"></div>

              <!-- Top Speaker Micro-Ear-Piece Slit -->
              <div class="phone-earpiece-slit"></div>

              <!-- Authentic iOS Status Bar -->
              <div class="phone-status-bar">
                <span class="phone-time-display">09:41</span>

                <!-- Dynamic Island with Optics -->
                <div class="phone-island">
                  <div class="island-camera-lens"></div>
                  <div class="island-truedepth-dot"></div>
                </div>

                <!-- iOS Status Icons -->
                <div class="phone-status-icons">
                  <div class="ios-signal-bars">
                    <span class="bar bar-1"></span>
                    <span class="bar bar-2"></span>
                    <span class="bar bar-3"></span>
                    <span class="bar bar-4"></span>
                  </div>
                  <span class="ios-5g-text">5G</span>
                  <div class="ios-battery-pill">
                    <div class="battery-charge"></div>
                  </div>
                </div>
              </div>

              <!-- In-App Search Header -->
              <div class="phone-app-bar">
                <div class="phone-search-row">
                  <div class="phone-search-box">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    <span>Ürün, mağaza veya kupon ara...</span>
                  </div>
                  <div class="phone-avatar-badge">
                    <i class="fa-regular fa-bell"></i>
                    <span class="phone-notif-dot"></span>
                  </div>
                </div>
              </div>

              <!-- Screen Views Container (Interactive Tab Pages) -->
              <div class="phone-screen-container">

                <!-- ==========================================
                   VIEW 1: ANASAYFA (2x2 Grid View like Flutter)
                   ========================================== -->
                <div class="phone-screen-view active" id="view-anasayfa">
                  <!-- Mini Filter Chips -->
                  <div class="phone-chips-row">
                    <span class="phone-chip active" data-filter="all">🔥 Tümü</span>
                    <span class="phone-chip" data-filter="pc">💻 Bilgisayar</span>
                    <span class="phone-chip" data-filter="phone">📱 Telefon</span>
                    <span class="phone-chip" data-filter="home">🏠 Ev & Yaşam</span>
                  </div>

                  <!-- 2x2 Grid with 4 Deals -->
                  <div class="phone-deals-grid-2x2" id="deals-grid-container">

                    <!-- Deal 1 -->
                    <div class="grid-deal-card" data-cat="pc">
                      <div class="grid-deal-media">
                        <img
                          src="https://images.unsplash.com/photo-1517336714731-489689fd1ca8?auto=format&fit=crop&w=300&q=80"
                          alt="MacBook Pro" class="grid-deal-img"
                          onerror="this.style.display='none'; this.nextElementSibling.style.display='block';">
                        <i class="fa-solid fa-laptop grid-deal-fallback-icon" style="display: none;"></i>
                        <span class="grid-deal-time"><i class="fa-regular fa-clock"></i> 14d</span>
                        <span class="grid-deal-discount">-%38</span>
                        <div class="grid-deal-store">
                          <img src="assets/amazon.webp" alt="Amazon" onerror="this.src='favicon.png'">
                          <span>Amazon</span>
                        </div>
                      </div>
                      <div class="grid-deal-info">
                        <h5 class="grid-deal-title">Apple MacBook Pro 14" M3 Pro 512GB</h5>
                        <div class="grid-deal-price-row">
                          <span class="grid-deal-price">68.499 ₺</span>
                          <span class="grid-deal-oldprice">109.999 ₺</span>
                        </div>
                        <div class="grid-deal-badge-row">
                          <span class="grid-deal-dip">Dip Fiyat</span>
                        </div>
                        <div class="grid-deal-footer">
                          <div class="grid-vote-pill sim-vote-btn" data-votes="142">
                            <i class="fa-solid fa-fire"></i> <span class="vote-num">142</span>
                          </div>
                          <span class="grid-deal-comments"><i class="fa-regular fa-comment"></i> 34</span>
                        </div>
                      </div>
                    </div>

                    <!-- Deal 2 -->
                    <div class="grid-deal-card" data-cat="home">
                      <div class="grid-deal-media">
                        <img
                          src="https://images.unsplash.com/photo-1558317374-067fb5f30001?auto=format&fit=crop&w=300&q=80"
                          alt="Dyson V15" class="grid-deal-img"
                          onerror="this.style.display='none'; this.nextElementSibling.style.display='block';">
                        <i class="fa-solid fa-wand-magic-sparkles grid-deal-fallback-icon"
                          style="display: none; color: #60A5FA;"></i>
                        <span class="grid-deal-time"><i class="fa-regular fa-clock"></i> 26d</span>
                        <span class="grid-deal-discount">-%42</span>
                        <div class="grid-deal-store">
                          <img src="assets/hepsiburada.webp" alt="Hepsiburada" onerror="this.src='favicon.png'">
                          <span>Hepsiburada</span>
                        </div>
                      </div>
                      <div class="grid-deal-info">
                        <h5 class="grid-deal-title">Dyson V15 Detect Absolute Süpürge</h5>
                        <div class="grid-deal-price-row">
                          <span class="grid-deal-price">21.999 ₺</span>
                          <span class="grid-deal-oldprice">37.999 ₺</span>
                        </div>
                        <div class="grid-deal-badge-row">
                          <span class="grid-deal-dip">Flaş İndirim</span>
                        </div>
                        <div class="grid-deal-footer">
                          <div class="grid-vote-pill sim-vote-btn" data-votes="89">
                            <i class="fa-solid fa-fire"></i> <span class="vote-num">89</span>
                          </div>
                          <span class="grid-deal-comments"><i class="fa-regular fa-comment"></i> 62</span>
                        </div>
                      </div>
                    </div>

                    <!-- Deal 3 -->
                    <div class="grid-deal-card" data-cat="phone">
                      <div class="grid-deal-media">
                        <img
                          src="https://images.unsplash.com/photo-1505740420928-5e560c06d30e?auto=format&fit=crop&w=300&q=80"
                          alt="Sony WH-1000XM5" class="grid-deal-img"
                          onerror="this.style.display='none'; this.nextElementSibling.style.display='block';">
                        <i class="fa-solid fa-headphones grid-deal-fallback-icon"
                          style="display: none; color: #FBBF24;"></i>
                        <span class="grid-deal-time"><i class="fa-regular fa-clock"></i> 41d</span>
                        <span class="grid-deal-discount">-%30</span>
                        <div class="grid-deal-store">
                          <img src="assets/trendyol.webp" alt="Trendyol" onerror="this.src='favicon.png'">
                          <span>Trendyol</span>
                        </div>
                      </div>
                      <div class="grid-deal-info">
                        <h5 class="grid-deal-title">Sony WH-1000XM5 ANC Kulaklık</h5>
                        <div class="grid-deal-price-row">
                          <span class="grid-deal-price">11.499 ₺</span>
                          <span class="grid-deal-oldprice">16.499 ₺</span>
                        </div>
                        <div class="grid-deal-badge-row">
                          <span class="grid-deal-dip">Popüler Fırsat</span>
                        </div>
                        <div class="grid-deal-footer">
                          <div class="grid-vote-pill sim-vote-btn" data-votes="64">
                            <i class="fa-solid fa-fire"></i> <span class="vote-num">64</span>
                          </div>
                          <span class="grid-deal-comments"><i class="fa-regular fa-comment"></i> 28</span>
                        </div>
                      </div>
                    </div>

                    <!-- Deal 4 -->
                    <div class="grid-deal-card" data-cat="home">
                      <div class="grid-deal-media">
                        <img
                          src="https://images.unsplash.com/photo-1588854337236-6889d631faa8?auto=format&fit=crop&w=300&q=80"
                          alt="Philips Airfryer" class="grid-deal-img"
                          onerror="this.style.display='none'; this.nextElementSibling.style.display='block';">
                        <i class="fa-solid fa-utensils grid-deal-fallback-icon"
                          style="display: none; color: #34D399;"></i>
                        <span class="grid-deal-time"><i class="fa-regular fa-clock"></i> 55d</span>
                        <span class="grid-deal-discount">-%45</span>
                        <div class="grid-deal-store">
                          <img src="assets/teknosa.webp" alt="Teknosa" onerror="this.src='favicon.png'">
                          <span>Teknosa</span>
                        </div>
                      </div>
                      <div class="grid-deal-info">
                        <h5 class="grid-deal-title">Philips XXL Akıllı Fritöz Airfryer</h5>
                        <div class="grid-deal-price-row">
                          <span class="grid-deal-price">4.299 ₺</span>
                          <span class="grid-deal-oldprice">7.899 ₺</span>
                        </div>
                        <div class="grid-deal-badge-row">
                          <span class="grid-deal-dip">En Düşük Fiyat</span>
                        </div>
                        <div class="grid-deal-footer">
                          <div class="grid-vote-pill sim-vote-btn" data-votes="110">
                            <i class="fa-solid fa-fire"></i> <span class="vote-num">110</span>
                          </div>
                          <span class="grid-deal-comments"><i class="fa-regular fa-comment"></i> 51</span>
                        </div>
                      </div>
                    </div>

                  </div>
                </div>

                <!-- ==========================================
                   VIEW 2: AKTUEL (36 Store Catalogs Simulation)
                   ========================================== -->
                <!-- ==========================================
                   VIEW 2: AKTUEL (Haftalık Aktüel Afişler)
                   ========================================== -->
                <div class="phone-screen-view" id="view-aktuel">
                  <div class="aktuel-sim-header">
                    <span class="aktuel-sim-title">📰 Haftalık Aktüel Afişler</span>
                    <span style="font-size: 0.625rem; color: #34D399; font-weight: 800;"><i class="fa-solid fa-circle"
                        style="font-size: 6px;"></i> 40+ Market</span>
                  </div>

                  <div class="aktuel-store-grid">
                    <!-- BİM -->
                    <div class="aktuel-card">
                      <div class="aktuel-logo-wrap">
                        <img src="assets/bim.webp" alt="BİM" onerror="this.src='favicon.png'">
                      </div>
                      <div class="aktuel-name">BİM</div>
                      <div class="aktuel-status-pill urgent">Bugün son!</div>
                    </div>

                    <!-- A101 -->
                    <div class="aktuel-card">
                      <div class="aktuel-logo-wrap">
                        <img src="assets/a101.webp" alt="A101" onerror="this.src='favicon.png'">
                      </div>
                      <div class="aktuel-name">A101</div>
                      <div class="aktuel-status-pill upcoming">2 gün sonra başlayacak</div>
                    </div>

                    <!-- ŞOK -->
                    <div class="aktuel-card">
                      <div class="aktuel-logo-wrap">
                        <img src="assets/sok.webp" alt="ŞOK" onerror="this.src='favicon.png'">
                      </div>
                      <div class="aktuel-name">ŞOK</div>
                      <div class="aktuel-status-pill alert">3 gün kaldı</div>
                    </div>

                    <!-- Migros -->
                    <div class="aktuel-card">
                      <div class="aktuel-logo-wrap">
                        <img src="assets/migros.webp" alt="Migros" onerror="this.src='favicon.png'">
                      </div>
                      <div class="aktuel-name">Migros</div>
                      <div class="aktuel-status-pill ongoing">2 hafta sonra bitecek</div>
                    </div>
                  </div>

                  <div class="aktuel-sim-info">
                    <span class="pulse-dot emerald" style="width: 6px; height: 6px;"></span>
                    <span>Tüm market afişleri her sabah 06:00'da taranır ve güncellenir.</span>
                  </div>
                </div>

                <!-- ==========================================
                   VIEW 3: FIRSAT PAYLAS (AI-Powered Link Scanner)
                   ========================================== -->
                <div class="phone-screen-view" id="view-paylas">
                  <div class="share-sim-header">
                    <span class="share-sim-title">
                      <i class="fa-solid fa-wand-magic-sparkles" style="color: #FF6B35;"></i> Fırsat Paylaş
                    </span>
                    <span class="badge-pill emerald" style="font-size: 0.5625rem; padding: 2px 7px;">AI Destekli</span>
                  </div>

                  <!-- AI Link Scanner Box -->
                  <div class="share-scanner-box">
                    <div class="share-scanner-label">
                      <i class="fa-solid fa-robot" style="color: #60A5FA;"></i>
                      <span>Akıllı Bağlantı Analizörü</span>
                    </div>
                    <div class="share-input-row">
                      <div class="share-input-field">
                        <i class="fa-solid fa-link"></i>
                        <input type="text" id="share-sim-input" value="https://amazon.com.tr/dp/B0CX..." readonly>
                      </div>
                      <button class="share-scan-action-btn" id="share-sim-btn">
                        <i class="fa-solid fa-bolt"></i> Tara
                      </button>
                    </div>
                    <div class="share-status-tag">
                      <span class="pulse-dot emerald" style="width: 5px; height: 5px;"></span>
                      <span>Amazon TR algılandı • 30+ Mağaza Radarda</span>
                    </div>
                  </div>

                  <!-- Extracted Dummy Fields Simulation (Başlık, Fiyat, Açıklama) -->
                  <div class="share-extracted-box" id="share-extracted-fields">
                    <!-- Alan 1: Başlık -->
                    <div class="share-form-field">
                      <div class="share-field-header">
                        <label><i class="fa-solid fa-heading"></i> Başlık</label>
                        <span class="field-status-chip">AI Otomatik</span>
                      </div>
                      <div class="share-field-value" id="field-sim-title">
                        Apple AirPods Pro 2. Nesil USB-C MagSafe
                      </div>
                    </div>

                    <!-- Alan 2: Fiyat & İndirim -->
                    <div class="share-form-field">
                      <div class="share-field-header">
                        <label><i class="fa-solid fa-tag"></i> Fiyat</label>
                        <span class="field-status-chip dip">Dip Fiyat</span>
                      </div>
                      <div class="share-field-value price-field" id="field-sim-price">
                        <span class="current-price">7.299 ₺</span>
                        <span class="original-price">9.499 ₺</span>
