  <!-- ==========================================================================
       Killer Feature 4: Güncel İndirim Kuponları & Sepet İndirimleri
       ========================================================================== -->
  <section id="kuponlar" style="background: rgba(8, 11, 17, 0.4);">
    <div class="container">
      <div class="section-header">
        <div class="badge-pill gold">
          <i class="fa-solid fa-ticket"></i>
          <span>İNDİRİM KUPONLARI</span>
        </div>
        <h2>İndirim Kuponlarını <span class="gradient-text-fire">Tek Tıkla Kopyala</span></h2>
        <p>
          Süresi geçmiş kuponlarla vakit kaybetmeyin. Trendyol, Amazon ve yüzlerce mağazanın aktif sepet kodları
          parmaklarınızın ucunda.
        </p>
      </div>

      <!-- Coupon Cards Grid -->
