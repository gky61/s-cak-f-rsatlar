rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /deals/{allPaths=**} {
      // Görseller herkes tarafından okunabilir (uygulama anonim HTTP ile indiriyor)
      allow read: if true;
      // Kimliği doğrulanmış kullanıcılar (admin paneli dahil) görsel yükleyebilir
      allow write: if request.auth != null;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
