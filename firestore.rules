rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ========================================
    // HELPER FUNCTIONS
    // ========================================
    
    // Kullanıcı giriş yapmış mı?
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // İstek yapan kullanıcının ID'si
    function userId() {
      return request.auth.uid;
    }
    
    // Kullanıcı admin mi?
    function isAdmin() {
      return isAuthenticated() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isadmin == true ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == 'true'
      );
    }
    
    // Kullanıcı engellenmiş mi?
    function isBlocked() {
      return exists(/databases/$(database)/documents/blockedUsers/$(request.auth.uid));
    }
    
    // Engellenmiş kullanıcı yazamaz
    function canWrite() {
      return isAuthenticated() && !isBlocked();
    }
    
    // ========================================
    // USERS COLLECTION
    // ========================================
    match /users/{targetUserId} {
      // Herkes okuyabilir (profil bilgileri ve yazar detayları için)
      allow read: if true;
      
      // Kendi profilini oluştururken asla isAdmin veya rol alanlarını set edemez
      allow create: if isAuthenticated() && (
        isAdmin() || (
          userId() == targetUserId &&
          (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == false) &&
          (!('isadmin' in request.resource.data) || request.resource.data.isadmin == false) &&
          (!('role' in request.resource.data) || request.resource.data.role != 'admin')
        )
      );
      
      // Sadece kendi profilini veya admin güncelleyebilir.
      // Normal kullanıcı kendi profilinde isAdmin, isadmin, role, isBanned alanlarını ASLA değiştiremez.
      // Başka bir kullanıcı sadece followersWithNotifications alanını güncelleyebilir (takip/zil için)
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (
          userId() == targetUserId &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin', 'isadmin', 'role', 'isBanned'])
        ) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followersWithNotifications']))
      );
      
      // Sadece kendi profilini veya admin silebilir
      allow delete: if isAuthenticated() && (userId() == targetUserId || isAdmin());
      
      // Favoriler subcollection
      match /favorites/{dealId} {
        allow read: if isAuthenticated() && userId() == targetUserId;
        allow write: if canWrite() && userId() == targetUserId;
      }
      
      // Kullanıcı bildirimleri (Bildirim Merkezi)
      match /notifications/{notificationId} {
        allow read, write: if isAuthenticated() && (userId() == targetUserId || isAdmin());
      }
      
      // Kullanıcı bildirim tercihleri
      match /notificationPreferences/{documentId} {
        allow read, write: if isAuthenticated() && userId() == targetUserId;
      }
    }
    
    // ========================================
    // DEALS COLLECTION
    // ========================================
    match /deals/{dealId} {
      // Herkes onaylı fırsatları okuyabilir
      allow read: if true;
      
      // Giriş yapmış ve engellenmemiş kullanıcılar fırsat ekleyebilir (deal ban kontrolü ve alan doğrulama)
      allow create: if canWrite() && 
                    !exists(/databases/$(database)/documents/dealBannedUsers/$(request.auth.uid)) &&
                    (isAdmin() || (
                      request.resource.data.postedBy == userId() &&
                      request.resource.data.hotVotes == 0 &&
                      request.resource.data.coldVotes == 0 &&
                      (!('commentCount' in request.resource.data) || request.resource.data.commentCount == 0) &&
                      (!('expiredVotes' in request.resource.data) || request.resource.data.expiredVotes == 0) &&
                      (!('isExpired' in request.resource.data) || request.resource.data.isExpired == false) &&
                      (!('isEditorPick' in request.resource.data) || request.resource.data.isEditorPick == false) &&
                      (!('isApproved' in request.resource.data) || request.resource.data.isApproved == false || 
                       (exists(/databases/$(database)/documents/settings/app) && get(/databases/$(database)/documents/settings/app).data.dealApprovalRequired == false))
                    ));
      
      // Sahibi sadece belirli alanları (başlık, açıklama vb.) güncelleyebilir;
      // ancak onay durumunu (isApproved), editör seçimini (isEditorPick), yazarı (postedBy) veya oyları (hotVotes, coldVotes) ASLA değiştiremez!
      // Giriş yapmış herhangi bir kullanıcı sadece oy/yorum sayacı alanlarını güncelleyebilir (Asla negatif olamaz).
      allow update: if canWrite() && (
        isAdmin() ||
        (
          resource.data.postedBy == userId() &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isApproved', 'isEditorPick', 'postedBy', 'hotVotes', 'coldVotes']) &&
          (!('commentCount' in request.resource.data) || request.resource.data.commentCount >= 0) &&
          (!('hotVotes' in request.resource.data) || request.resource.data.hotVotes >= 0) &&
          (!('coldVotes' in request.resource.data) || request.resource.data.coldVotes >= 0)
        ) ||
        (request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['hotVotes', 'coldVotes', 'expiredVotes', 'isExpired', 'commentCount', 'updatedAt']) &&
         (!('commentCount' in request.resource.data) || request.resource.data.commentCount >= 0) &&
         (!('hotVotes' in request.resource.data) || request.resource.data.hotVotes >= 0) &&
         (!('coldVotes' in request.resource.data) || request.resource.data.coldVotes >= 0))
      );
      
      // Sahibi veya admin silebilir
      allow delete: if isAuthenticated() && 
                    (resource.data.postedBy == userId() || isAdmin());
      
      // Votes subcollection
      match /votes/{voteUserId} {
        allow read: if isAuthenticated();
        allow write: if canWrite() && userId() == voteUserId;
      }
      
      // Expired votes subcollection
      match /expired_votes/{expiredUserId} {
        allow read: if isAuthenticated();
        allow write: if canWrite() && userId() == expiredUserId;
      }
      
      // Comments subcollection
      match /comments/{commentId} {
        allow read: if true;
        allow create: if canWrite() && 
                      !exists(/databases/$(database)/documents/commentBannedUsers/$(request.auth.uid)) &&
                      request.resource.data.userId == userId();
        allow update: if canWrite() && (
                      isAdmin() ||
                      (
                        resource.data.userId == userId() &&
                        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['userId', 'dealId', 'createdAt'])
                      ) ||
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']));
        allow delete: if isAuthenticated() && 
                      (resource.data.userId == userId() || isAdmin());
      }
    }
    
    // ========================================
    // MESSAGES COLLECTION (User-to-User)
    // ========================================
    match /messages/{messageId} {
      // Sadece gönderen, alıcı veya admin okuyabilir
      allow read: if isAuthenticated() && 
                  (resource == null ||
                   resource.data.senderId == userId() || 
                   resource.data.receiverId == userId() ||
                   isAdmin());
      
      // Giriş yapmış kullanıcılar mesaj gönderilebilir; admin herhangi bir gönderen adına simüle edebilir
      allow create: if canWrite() && (request.resource.data.senderId == userId() || isAdmin());
      
      // Alıcı veya gönderen sadece tepki (reactions), okundu durumu (isRead, readAt) veya silme referansı (deletedBy) güncelleyebilir.
      // Mesaj metni veya gönderen/alıcı bilgileri asla sonradan değiştirilemez!
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (
          (resource.data.receiverId == userId() || resource.data.senderId == userId()) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['senderId', 'receiverId', 'text', 'content', 'createdAt'])
        )
      );
      
      // Gönderen, alıcı veya admin silebilir
      allow delete: if isAuthenticated() && 
                    (resource.data.senderId == userId() || 
                     resource.data.receiverId == userId() || 
                     isAdmin());
    }

    // ========================================
    // TYPING STATUS COLLECTION
    // ========================================
    match /typingStatus/{statusId} {
      allow read: if isAuthenticated();
      allow create, update: if canWrite() && (request.resource.data.userId == userId() || isAdmin());
      allow delete: if isAuthenticated();
    }
    
    // ========================================
    // ADMIN TO USER MESSAGES
    // ========================================
    match /adminToUserMessages/{messageId} {
      // Sadece alıcı kullanıcı veya admin okuyabilir
      allow read: if isAuthenticated() && 
                  (resource.data.userId == userId() || isAdmin());
      
      // Sadece admin oluşturabilir
      allow create: if isAdmin();
      
      // Kullanıcı okundu işaretleyebilir, admin güncelleyebilir
      allow update: if isAuthenticated() && 
                    (resource.data.userId == userId() || isAdmin());
      
      // Sadece alıcı veya admin silebilir
      allow delete: if isAuthenticated() && 
                    (resource.data.userId == userId() || isAdmin());
    }
    
    // ========================================
    // ADMIN MESSAGES (Moderation logs)
    // ========================================
    match /adminMessages/{messageId} {
      // Sadece admin okuyabilir/yazabilir
      allow read, write: if isAdmin();
    }
    
    // ========================================
    // BLOCKED USERS
    // ========================================
    match /blockedUsers/{blockedUserId} {
      // Sadece admin yönetebilir
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // ========================================
    // BANNED USERS (Comment/Deal bans)
    // ========================================
    match /commentBannedUsers/{bannedUserId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    match /dealBannedUsers/{bannedUserId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // ========================================
    // SETTINGS
    // ========================================
    match /settings/{settingId} {
      // Herkes okuyabilir
      allow read: if true;
      // Sadece admin yazabilir
      allow write: if isAdmin();
    }
    
    // ========================================
    // REPORTS (Şikayet sistemi)
    // ========================================
    match /reports/{reportId} {
      // Adminler tüm raporları, giriş yapmış kullanıcılar kendi oluşturduğu raporları okuyabilir
      allow read: if isAdmin() || (isAuthenticated() && (resource == null || resource.data.reportedBy == userId()));
      // Giriş yapmış ve engellenmemiş kullanıcılar kendi adına şikayet oluşturabilir
      allow create: if canWrite() && request.resource.data.reportedBy == userId();
      // Sadece admin güncelleyebilir/silebilir
      allow update, delete: if isAdmin();
    }
    
    // ========================================
    // NOTIFICATIONS CENTER (FAZ 3)
    // ========================================
    match /notificationLogs/{logId} {
      allow read, write: if isAdmin();
    }
    
    match /notificationStats/{statId} {
      allow read, write: if isAdmin();
    }
    
    // Comments collectionGroup rule for notifications/reports (Sadece okuma; yazma işlemleri /deals/{dealId}/comments yolundan denetlenir)
    match /{path=**}/comments/{commentId} {
      allow read: if true;
    }

    // ========================================
    // SYSTEM ERRORS LOGS (FAZ 4)
    // ========================================
    match /systemErrors/{errorId} {
      allow read, update, delete: if isAdmin();
      allow create: if isAdmin() || (
        request.resource.data.keys().hasAll(['errorType', 'message', 'platform']) &&
        request.resource.data.message is string &&
        request.resource.data.message.size() <= 1000 &&
        request.resource.data.errorType is string &&
        request.resource.data.errorType.size() <= 100 &&
        request.resource.data.platform in ['android', 'ios', 'web', 'backend', 'bot'] &&
        (!('severity' in request.resource.data) || request.resource.data.severity in ['info', 'warning', 'error', 'fatal']) &&
        (!('environment' in request.resource.data) || request.resource.data.environment in ['dev', 'prod'])
      );
    }

    // ========================================
    // NOTIFICATION SUBSCRIPTIONS
    // ========================================
    match /notificationSubscriptions/{subscriptionId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.uid == userId() || resource.data.userId == userId());
      allow write: if canWrite() && 
                   (request.resource == null || request.resource.data.uid == userId() || request.resource.data.userId == userId()) && 
                   (resource == null || resource.data.uid == userId() || resource.data.userId == userId());
    }
    // ========================================
    // KUPONLAR COLLECTION
    // ========================================
    match /kuponlar/{kuponId} {
      allow read: if true;
      allow create: if canWrite() && (
        isAdmin() || (
          request.resource.data.paylasanKullaniciId == userId() &&
          (!('sicakOySayisi' in request.resource.data) || request.resource.data.sicakOySayisi == 0) &&
          (!('sogukOySayisi' in request.resource.data) || request.resource.data.sogukOySayisi == 0)
        )
      );
      // Sahip oyları veya paylaşan kişi ID'sini doğrudan değiştiremez.
      // Giriş yapmış herhangi bir kullanıcı sadece oy sayaçlarını ve durumu güncelleyebilir (Asla negatif olamaz).
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (
          resource.data.paylasanKullaniciId == userId() &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['paylasanKullaniciId', 'sicakOySayisi', 'sogukOySayisi'])
        ) ||
        (request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['sicakOySayisi', 'sogukOySayisi', 'durum']) &&
         (!('sicakOySayisi' in request.resource.data) || request.resource.data.sicakOySayisi >= 0) &&
         (!('sogukOySayisi' in request.resource.data) || request.resource.data.sogukOySayisi >= 0))
      );
      allow delete: if isAuthenticated() && (resource.data.paylasanKullaniciId == userId() || isAdmin());

      // Votes subcollection - kullanıcının oy kayıtları
      match /votes/{voteUserId} {
        allow read: if isAuthenticated();
        allow write: if canWrite() && userId() == voteUserId;
      }
    }

    // ========================================
    // KATALOGLAR COLLECTION
    // ========================================
    match /kataloglar/{katalogId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ========================================
    // USER DEVICES
    // ========================================
    match /userDevices/{deviceId} {
      allow read: if isAdmin() || (isAuthenticated() && (resource == null || resource.data.uid == userId() || resource.data.userId == userId()));
      allow write: if isAdmin() || (canWrite() && 
                   (request.resource == null || request.resource.data.uid == userId() || request.resource.data.userId == userId()) && 
                   (resource == null || resource.data.uid == userId() || resource.data.userId == userId()));
    }

    // ========================================
    // SYSTEM CONFIG
    // ========================================
    match /systemConfig/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ========================================
    // TEST AUTOMATION COMMANDS
    // ========================================
    match /mobileTestCommands/{commandId} {
      allow read, write: if isAdmin();
    }

    // ========================================
    // COLLECTION GROUP: NOTIFICATIONS
    // ========================================
    match /{path=**}/notifications/{notificationId} {
      allow read, write: if isAdmin();
    }

    // ========================================
    // FALLBACK RULE - Diğer tüm koleksiyonlar
    // ========================================
    match /{document=**} {
      // Varsayılan olarak hiçbir erişime izin verme
      allow read, write: if false;
    }
  }
}
