# ==============================================================================
# FırsatKolik iOS CI/CD — Fastlane TestFlight Dağıtım Yapılandırması
# ==============================================================================
# Apple'ın xcrun altool aracını aşamalı kaldırması ve App Store Connect API'ye
# geçişi nedeniyle en modern, resmi ve kararlı TestFlight yükleme motorudur.
# ==============================================================================

default_platform(:ios)

platform :ios do
  desc "FırsatKolik IPA paketini App Store Connect API v1 ile TestFlight'a yükler"
  lane :beta do |options|
    raw_path = options[:ipa] || ENV["IPA_FILE"]

    # Göreceli yol verilmişse hem mevcut dizini hem de bir üst proje kök dizinini kontrol et
    ipa_path = if raw_path.nil?
      nil
    elsif File.exist?(File.expand_path(raw_path))
      File.expand_path(raw_path)
    elsif File.exist?(File.expand_path(File.join("..", raw_path)))
      File.expand_path(File.join("..", raw_path))
    else
      raw_path
    end

    if ipa_path.nil? || !File.exist?(ipa_path)
      UI.user_error!("❌ Hata: Yüklenecek IPA dosyası bulunamadı: #{raw_path}")
    end

    UI.message("🚀 App Store Connect API anahtarı yapılandırılıyor...")
    key_filepath = File.expand_path("~/.appstoreconnect/private_keys/AuthKey_#{ENV['APP_STORE_CONNECT_KEY_ID']}.p8")

    if File.exist?(key_filepath)
      api_key = app_store_connect_api_key(
        key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
        issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
        key_filepath: key_filepath,
        in_house: false
      )
    else
      api_key = app_store_connect_api_key(
        key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
        issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
        key_content: ENV["APP_STORE_CONNECT_PRIVATE_KEY"],
        is_key_content_base64: false,
        in_house: false
      )
    end

    UI.message("📦 IPA TestFlight'a aktarılıyor: #{ipa_path}")
    # skip_waiting_for_build_processing: true -> Apple'ın 10-15 dakikalık işleme
    # sürecini beklemeden derlemeyi bitirir. Bu sayede GitHub Actions'ın 10x
    # macOS dakika kotası (aylık 200 dk) gereksiz yere tüketilmez!
    upload_to_testflight(
      api_key: api_key,
      app_identifier: "com.firsatkolik.app",
      ipa: ipa_path,
      skip_waiting_for_build_processing: true,
      skip_submission: true,
      distribute_external: false
    )

    UI.success("🎉 FırsatKolik IPA paketi başarıyla Apple TestFlight'a yüklendi!")
  end
end
