# Global iOS platform target for modern Firebase, AdMob and Sign in with Apple
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end

  # Share Extension: receive_sharing_intent framework ve başlıklarını Runner'dan devralır
  target 'ShareExtension' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.build_configurations.each do |config|
    config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
    config.build_settings['ENABLE_BITCODE'] = 'NO'
    config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
    config.build_settings['ENABLE_USER_SCRIPT_SANDBOXING'] = 'NO'

    ['OTHER_CFLAGS', 'OTHER_CPLUSPLUSFLAGS', 'WARNING_CFLAGS'].each do |setting|
      if config.build_settings[setting]
        if config.build_settings[setting].is_a?(String)
          config.build_settings[setting] = config.build_settings[setting].gsub(/-?GCC_WARN_INHIBIT_ALL_WARNINGS/, '').strip
        elsif config.build_settings[setting].is_a?(Array)
          config.build_settings[setting].reject! { |flag| flag.to_s.include?('GCC_WARN_INHIBIT_ALL_WARNINGS') }
        end
      end
    end
  end

  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    # 1. Xcode 16 Clang '-G' Hatasi Cozumu:
    # Xcode 16 clang derleyicisi BoringSSL-GRPC podspec'indeki '-GCC_WARN_INHIBIT_ALL_WARNINGS'
    # bayragini '-G' opsiyonu olarak yanlis ayristirmakta ve derleme hatasina yol acmaktadir.
    # Bu bayragi derleme yapilandirmalarindan ve kaynak dosyalarindan temizliyoruz.
    phases = []
    phases << target.source_build_phase if target.respond_to?(:source_build_phase) && target.source_build_phase
    phases += target.build_phases if target.respond_to?(:build_phases) && target.build_phases
    cleaned_source_flags = false

    phases.uniq.each do |phase|
      if phase.respond_to?(:files) && phase.files
        phase.files.each do |file|
          if file.settings && file.settings['COMPILER_FLAGS']
            if file.settings['COMPILER_FLAGS'].is_a?(String)
              if file.settings['COMPILER_FLAGS'].include?('GCC_WARN_INHIBIT_ALL_WARNINGS')
                flags = file.settings['COMPILER_FLAGS'].split
                flags.reject! { |flag| flag.include?('GCC_WARN_INHIBIT_ALL_WARNINGS') }
                file.settings['COMPILER_FLAGS'] = flags.join(' ')
                cleaned_source_flags = true
              end
            elsif file.settings['COMPILER_FLAGS'].is_a?(Array)
              if file.settings['COMPILER_FLAGS'].any? { |flag| flag.to_s.include?('GCC_WARN_INHIBIT_ALL_WARNINGS') }
                file.settings['COMPILER_FLAGS'].reject! { |flag| flag.to_s.include?('GCC_WARN_INHIBIT_ALL_WARNINGS') }
                cleaned_source_flags = true
              end
            end
          end
        end
      end
    end

    if cleaned_source_flags
      puts "[Podfile] Cleared -GCC_WARN_INHIBIT_ALL_WARNINGS compiler flag from #{target.name}"
    end

    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      config.build_settings['ENABLE_BITCODE'] = 'NO'
      config.build_settings['GCC_WARN_INHIBIT_ALL_WARNINGS'] = 'YES'
      config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
      config.build_settings['ENABLE_USER_SCRIPT_SANDBOXING'] = 'NO'

      ['OTHER_CFLAGS', 'OTHER_CPLUSPLUSFLAGS', 'WARNING_CFLAGS'].each do |setting|
        if config.build_settings[setting]
          if config.build_settings[setting].is_a?(String)
            config.build_settings[setting] = config.build_settings[setting].gsub(/-?GCC_WARN_INHIBIT_ALL_WARNINGS/, '').strip
          elsif config.build_settings[setting].is_a?(Array)
            config.build_settings[setting].reject! { |flag| flag.to_s.include?('GCC_WARN_INHIBIT_ALL_WARNINGS') }
          end
        end
      end

      # 2. Xcode 16 Non-Modular Header Issue Cozumu:
      # Moduler framework icinde non-modular header importlarina izin ver
      ['OTHER_CFLAGS', 'OTHER_CPLUSPLUSFLAGS'].each do |setting|
        current = config.build_settings[setting] || '$(inherited)'
        flag = '-Wno-error=non-modular-include-in-framework-module'
        if current.is_a?(String)
          config.build_settings[setting] = "#{current} #{flag}" unless current.include?(flag)
        elsif current.is_a?(Array)
          config.build_settings[setting] << flag unless current.include?(flag)
        end
      end

      # 3. Xcode 16.3+ / Clang 19 C++ Template Argument Issue Cozumu:
      # gRPC-Core basic_seq.h icindeki template kw uyarisi/hatasini bastir
      ['OTHER_CFLAGS', 'OTHER_CPLUSPLUSFLAGS'].each do |setting|
        current = config.build_settings[setting] || '$(inherited)'
        flag = '-Wno-missing-template-arg-list-after-template-kw'
        if current.is_a?(String)
          config.build_settings[setting] = "#{current} #{flag}" unless current.include?(flag)
        elsif current.is_a?(Array)
          config.build_settings[setting] << flag unless current.include?(flag)
        end
      end
    end
  end

  # 4. gRPC-Core basic_seq.h Dosya Duzeyi Duzeltmesi (Xcode 16.3+ Clang 19):
  # Traits::template CallSeqFactory(...) cagrilarina eksik olan <> sablon argumanini ekle
  pods_roots = []
  pods_roots << installer.sandbox.root if installer.respond_to?(:sandbox) && installer.sandbox.respond_to?(:root)
  pods_roots << File.join(__dir__, 'Pods')
  pods_roots << File.join(Dir.pwd, 'Pods')
  pods_roots << File.join(Dir.pwd, 'ios', 'Pods')

  patched_grpc_count = 0
  pods_roots.compact.uniq.each do |proot|
    next unless Dir.exist?(proot.to_s)
    Dir.glob(File.join(proot.to_s, '**', 'basic_seq.h')).each do |hpath|
      begin
        hcontent = File.read(hpath)
        if hcontent.include?('Traits::template CallSeqFactory(')
          hnew = hcontent.gsub('Traits::template CallSeqFactory(', 'Traits::template CallSeqFactory<>(')
          File.write(hpath, hnew)
          patched_grpc_count += 1
          puts "[Podfile] Patched gRPC-Core header: #{hpath}"
        end
      rescue => e
        puts "[Podfile] Warning: Could not patch #{hpath}: #{e}"
      end
    end
  end
  if patched_grpc_count > 0
    puts "[Podfile] Successfully patched #{patched_grpc_count} gRPC-Core basic_seq.h file(s) for Xcode 16.3+ Clang 19 compliance."
  end
end

