<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Güvenli: Cleartext (HTTP) trafiği kapalı, sadece güvenli HTTPS izinli -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
